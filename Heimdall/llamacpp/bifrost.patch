+
+uint32_t llama_hparams::bifrost_state() const {
+    if (bifrost_window == 0) {
+        return 0;
+    }
+    const uint32_t d = n_embd_head_k(), h = n_head(0), hkv = n_head_kv(0);
+    return bifrost_window * bifrost_ring_ch() + bifrost_sinks * 2 * hkv * d + d * d * h;
+}
