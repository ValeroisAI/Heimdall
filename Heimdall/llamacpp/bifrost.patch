+bool llm_graph_input_bifrost::can_reuse(const llm_graph_params & params) {
+    const auto * mctx = static_cast<const llama_memory_hybrid_context *>(params.mctx)->get_recr();
+    return params.ubatch.n_seq_tokens == n_seq_tokens && params.ubatch.n_seqs == n_seqs &&
+           can_inplace(mctx, n_seqs) == inplace;
+}
