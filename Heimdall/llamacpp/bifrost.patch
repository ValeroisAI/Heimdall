+// ---------------------------------------------------------------------------------------------------------------------
+// Bifrost (Valerois): a full-attention layer converted to
+//     o = o_win + gamma * (mem_scale * o_mem - o_win),   y = W_o (o * sigmoid(gate))
+//   o_win : softmax attention over the S sink tokens + the last W tokens (the teacher's own q/k/v, exact inside W)
+//   o_mem : gated delta rule; token j is written when it leaves the window (t = j + W); one state per query head
+//   gamma : sigmoid(W_mix x + mix_lse * (lse_win - log W)) for pos >= W, else 0
+// Per-sequence state (recurrent memory row "cache_bifrost_l"): ring [W, C] | sinks [S, 2*G*D] | delta [D, D, H].
+// Reference implementation and tests: Heimdall/heimdall/hibrit.py (HybridAttention._student).
+
+void llm_graph_input_bifrost::set_input(const llama_ubatch * ubatch) {
+    const int64_t T = ubatch->n_seq_tokens, B = ubatch->n_seqs, W = window, S = sinks, L = S + W + T;
+    GGML_ASSERT(ubatch->n_tokens == T * B);
+
+    std::vector<float>   mask(L * T * B), ms(T * B), mw(T * B), sel(std::max<int64_t>(S, 1) * B, 0.0f);
+    std::vector<int32_t> idx(std::max<int64_t>(S, 1) * B, 0);
+
+    for (int64_t s = 0; s < B; ++s) {
+        const int64_t p0 = ubatch->pos[s * T];
+        for (int64_t t = 0; t < T; ++t) {
+            GGML_ASSERT(ubatch->pos[s * T + t] == p0 + t && "bifrost: positions must be consecutive within a sequence");
+            const int64_t q = p0 + t;
+            float * row = mask.data() + (s * T + t) * L;
+            for (int64_t l = 0; l < L; ++l) {
+                bool ok;
+                if (l < S) {
+                    ok = l <= q;                              // sink slot l holds position l
+                } else {
+                    const int64_t kp = p0 - W + (l - S);      // ring entries, then this ubatch's tokens
+                    ok = kp >= 0 && kp >= S && kp <= q && q - kp < W;
+                }
+                row[l] = ok ? 0.0f : -INFINITY;
+            }
+            ms[s * T + t] = q >= S ? 1.0f : 0.0f;
+            mw[s * T + t] = q >= W ? 1.0f : 0.0f;
+        }
+        for (int64_t j = 0; j < S; ++j) {
+            if (j >= p0 && j < p0 + T) {
+                idx[s * S + j] = (int32_t) (s * T + (j - p0));
+                sel[s * S + j] = 1.0f;
+            }
+        }
+    }
+    ggml_backend_tensor_set(kq_mask,  mask.data(), 0, ggml_nbytes(kq_mask));
+    ggml_backend_tensor_set(m_sink,   ms.data(),   0, ggml_nbytes(m_sink));
+    ggml_backend_tensor_set(m_win,    mw.data(),   0, ggml_nbytes(m_win));
+    ggml_backend_tensor_set(sink_idx, idx.data(),  0, ggml_nbytes(sink_idx));
+    ggml_backend_tensor_set(sink_sel, sel.data(),  0, ggml_nbytes(sink_sel));
+}
+
+ggml_tensor * llama_model_qwen35::graph::build_layer_bifrost(
+        llm_graph_input_rs *      inp,
+        llm_graph_input_bifrost * bi,
+        ggml_tensor *             cur,
+        ggml_tensor *             inp_pos,
+        int *                     sections,
+        int                       il) {
+    const auto & layer = model.layers[il];
+    const auto & bf    = layer.bifrost;
+
+    const int64_t D = hparams.n_embd_head_k();
+    const int64_t H = n_head, G = n_head_kv, R = H / G;
+    const int64_t W = hparams.bifrost_window, S = hparams.bifrost_sinks;
+    const int64_t T = ubatch.n_seq_tokens, B = ubatch.n_seqs;
+    const int64_t C = hparams.bifrost_ring_ch();
+    const int64_t GD = G * D;
+    const size_t  f4 = sizeof(float);
+
+    GGML_ASSERT(bi != nullptr && S > 0);
+    GGML_ASSERT(ubatch.equal_seqs() && ubatch.n_tokens == T * B);
+    GGML_ASSERT(cparams.n_rs_seq == 0 && "bifrost: recurrent rollback (MTP draft) is not supported yet");
+
+    ggml_tensor * x = cur;  // [n_embd, n_tokens]
+
+    // ---- teacher projections (unchanged): q + gate, k, v, QK-norm, partial M-RoPE
+    auto [Qcur_full, Kcur, Vcur] = build_qkv(layer, cur, D * 2, H, D, G, D, G, il, false);
+    const size_t es = ggml_element_size(Qcur_full);
+    ggml_tensor * Qn = ggml_view_3d(ctx0, Qcur_full, D, H, n_tokens, es * D * 2, es * D * 2 * H, 0);
+    Qn = build_norm(Qn, layer.attn_q_norm, nullptr, LLM_NORM_RMS, il);
+    ggml_tensor * gate = ggml_view_3d(ctx0, Qcur_full, D, H, n_tokens, es * D * 2, es * D * 2 * H, es * D);
+    gate = ggml_cont_2d(ctx0, gate, D * H, n_tokens);
+    ggml_tensor * Kn = build_norm(ggml_reshape_3d(ctx0, ggml_cont(ctx0, Kcur), D, G, n_tokens), layer.attn_k_norm, nullptr, LLM_NORM_RMS, il);
+    ggml_tensor * Vc = ggml_cont_3d(ctx0, Vcur, D, G, n_tokens);
+
+    ggml_tensor * Qr = ggml_rope_multi(ctx0, Qn, inp_pos, nullptr, n_rot, sections, rope_type, n_ctx_orig, freq_base,
+                                       freq_scale, ext_factor, attn_factor, beta_fast, beta_slow);
+    ggml_tensor * Kr = ggml_rope_multi(ctx0, Kn, inp_pos, nullptr, n_rot, sections, rope_type, n_ctx_orig, freq_base,
+                                       freq_scale, ext_factor, attn_factor, beta_fast, beta_slow);
+
+    // ---- memory inputs: qm = l2norm(F_q q), km = l2norm(F_k k) (pre-RoPE), g = A * softplus(a + dt), beta = sigma(b)
+    const float eps = hparams.f_norm_rms_eps;
+    ggml_tensor * qm = ggml_mul_mat(ctx0, bf.fq, ggml_cont(ctx0, ggml_permute(ctx0, Qn, 0, 2, 1, 3)));   // [D, n, H]
+    qm = build_gdn_l2_norm(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, qm, 0, 2, 1, 3)), eps);              // [D, H, n]
+    ggml_tensor * km = ggml_mul_mat(ctx0, bf.fk, ggml_cont(ctx0, ggml_permute(ctx0, Kn, 0, 2, 1, 3)));   // [D, n, G]
+    km = build_gdn_l2_norm(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, km, 0, 2, 1, 3)), eps);              // [D, G, n]
+
+    ggml_tensor * ab = ggml_add(ctx0, build_lora_mm(bf.ab, x), bf.ab_b);                                  // [2G, n]
+    ggml_tensor * a  = ggml_cont(ctx0, ggml_view_2d(ctx0, ab, G, n_tokens, ab->nb[1], 0));
+    ggml_tensor * bb = ggml_cont(ctx0, ggml_view_2d(ctx0, ab, G, n_tokens, ab->nb[1], G * ggml_element_size(ab)));
+    ggml_tensor * g    = ggml_mul(ctx0, ggml_softplus(ctx0, ggml_add(ctx0, a, bf.dt)), bf.a);             // [G, n]
+    ggml_tensor * beta = ggml_mul(ctx0, ggml_sigmoid(ctx0, bb), bi->m_sink);                             // [G, n]
+
+    // one ring row per token: [k_rope | v | k_mem | g | beta]
+    ggml_tensor * F = ggml_concat(ctx0, ggml_reshape_2d(ctx0, ggml_cont(ctx0, Kr), GD, n_tokens), ggml_reshape_2d(ctx0, Vc, GD, n_tokens), 0);
+    F = ggml_concat(ctx0, F, ggml_reshape_2d(ctx0, km, GD, n_tokens), 0);
+    F = ggml_concat(ctx0, F, g, 0);
+    F = ggml_concat(ctx0, F, beta, 0);                                                                   // [C, n]
+    GGML_ASSERT(F->ne[0] == C);
+
+    // ---- recurrent state of the sequences in this ubatch
+    const auto * mctx_cur = inp->mctx;
+    const int64_t kv_head = mctx_cur->get_head();
+    ggml_tensor * b_all = mctx_cur->get_b_l(il);
+    const int64_t Nb = hparams.bifrost_state();
+    const size_t  row = b_all->nb[1];
+    const size_t  off_sink = W * C * f4, off_delta = (W * C + S * 2 * GD) * f4;
+
+    ggml_tensor * st = build_rs(inp, b_all, Nb, B);                                                      // [Nb, B]
+    ggml_tensor * ring_old = ggml_cont(ctx0, ggml_view_3d(ctx0, st, C, W, B, C * f4, st->nb[1], 0));
+    ggml_tensor * sink_old = ggml_cont(ctx0, ggml_view_3d(ctx0, st, 2 * GD, S, B, 2 * GD * f4, st->nb[1], off_sink));
+    ggml_tensor * s_old    = ggml_cont(ctx0, ggml_view_4d(ctx0, st, D, D, H, B, D * f4, D * D * f4, st->nb[1], off_delta));
+
+    ggml_tensor * ext = ggml_concat(ctx0, ring_old, ggml_reshape_3d(ctx0, F, C, T, B), 1);              // [C, W+T, B]
+
+    // ring <- last W rows
+    ggml_build_forward_expand(gf, ggml_cpy(ctx0,
+        ggml_view_3d(ctx0, ext, C, W, B, ext->nb[1], ext->nb[2], T * ext->nb[1]),
+        ggml_view_3d(ctx0, b_all, C, W, B, C * f4, row, kv_head * row)));
+
+    // sinks <- positions < S seen in this ubatch
+    ggml_tensor * cand = ggml_get_rows(ctx0, ggml_cont(ctx0, ggml_view_2d(ctx0, F, 2 * GD, n_tokens, F->nb[1], 0)), bi->sink_idx);
+    cand = ggml_reshape_3d(ctx0, cand, 2 * GD, S, B);
+    ggml_tensor * sink_new = ggml_add(ctx0, sink_old, ggml_mul(ctx0, ggml_sub(ctx0, cand, sink_old), bi->sink_sel));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx0, sink_new,
+        ggml_view_3d(ctx0, b_all, 2 * GD, S, B, 2 * GD * f4, row, kv_head * row + off_sink)));
+
+    // ---- window + sink softmax attention (keys: S sinks, W ring, T new)
+    const int64_t Lk = S + W + T;
+    ggml_tensor * ext_kv = ggml_cont(ctx0, ggml_view_3d(ctx0, ext, 2 * GD, W + T, B, ext->nb[1], ext->nb[2], 0));
+    ggml_tensor * kv_all = ggml_concat(ctx0, sink_new, ext_kv, 1);                                       // [2GD, Lk, B]
+    ggml_tensor * K4 = ggml_view_4d(ctx0, kv_all, D, G, Lk, B, D * f4, kv_all->nb[1], kv_all->nb[2], 0);
+    ggml_tensor * V4 = ggml_view_4d(ctx0, kv_all, D, G, Lk, B, D * f4, kv_all->nb[1], kv_all->nb[2], GD * f4);
+    ggml_tensor * Kt = ggml_cont(ctx0, ggml_permute(ctx0, K4, 0, 2, 1, 3));                              // [D, Lk, G, B]
+    ggml_tensor * Vt = ggml_cont(ctx0, ggml_permute(ctx0, V4, 1, 2, 0, 3));                              // [Lk, D, G, B]
+    ggml_tensor * Qt = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_4d(ctx0, Qr, D, H, T, B), 0, 2, 1, 3)); // [D, T, H, B]
+
+    const float kq_scale = hparams.f_attention_scale == 0.0f ? 1.0f / sqrtf(float(D)) : hparams.f_attention_scale;
+    ggml_tensor * kq = ggml_mul_mat(ctx0, Kt, Qt);                                                       // [Lk, T, H, B]
+    ggml_mul_mat_set_prec(kq, GGML_PREC_F32);
+    ggml_tensor * p  = ggml_soft_max_ext(ctx0, kq, bi->kq_mask, kq_scale, 0.0f);
+    // log-sum-exp of the window: lse = E_p[s] + H(p)   (masked entries have p = 0)
+    ggml_tensor * lse = ggml_sub(ctx0,
+        ggml_sum_rows(ctx0, ggml_mul(ctx0, p, ggml_scale(ctx0, kq, kq_scale))),
+        ggml_sum_rows(ctx0, ggml_mul(ctx0, p, ggml_log(ctx0, ggml_clamp(ctx0, p, 1e-30f, 1.0f)))));      // [1, T, H, B]
+    ggml_tensor * o_win = ggml_mul_mat(ctx0, Vt, p);                                                     // [D, T, H, B]
+    o_win = ggml_cont(ctx0, ggml_permute(ctx0, o_win, 0, 2, 1, 3));                                      // [D, H, T, B]
+
+    // ---- memory: write rows = first T rows of ext (positions p0-W .. p0+T-1-W), heads expanded G -> H (h = g*R + r)
+    auto part = [&](int64_t ne0, size_t off) {
+        return ggml_cont(ctx0, ggml_view_3d(ctx0, ext, ne0, T, B, ext->nb[1], ext->nb[2], off));
+    };
+    auto expand = [&](ggml_tensor * z, int64_t d) {   // [d*G, T, B] -> [d, H, T, B]
+        z = ggml_reshape_4d(ctx0, z, d, 1, G, T * B);
+        z = ggml_repeat_4d(ctx0, z, d, R, G, T * B);
+        return ggml_reshape_4d(ctx0, z, d, H, T, B);
