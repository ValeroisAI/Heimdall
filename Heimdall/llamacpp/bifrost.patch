+uint32_t llama_hparams::bifrost_state() const {
+    if (bifrost_window == 0) {
+        return 0;
+    }
+    const uint32_t d = n_embd_head_k(), hkv = n_head_kv(0);
+    // region: sinks | ring of W+1 slots (slot = pos mod (W+1)) | one scratch slot, all rows [k_rope | v | k_mem | g | beta];
+    // then the delta state, one per KV head (the query heads of a group read the same state)
+    return (bifrost_sinks + bifrost_window + 2) * bifrost_ring_ch() + d * d * hkv;
+}
