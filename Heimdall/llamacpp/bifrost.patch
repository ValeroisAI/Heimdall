+    // decode reads the memory with a plain matmul, so the 1/sqrt(D) query scale of the delta rule is folded in here
+    ggml_tensor * qm = ggml_scale(ctx0, ggml_rms_norm(ctx0, per_head(bf.fq, Qn), eps / D), dec ? 1.0f / D : 1.0f / sqrtf(D));
+    ggml_tensor * km = build_gdn_l2_norm(ctx0, per_head(bf.fk, Kn), eps);                                // [D, G, n]
+
+    ggml_tensor * ab = ggml_add(ctx0, build_lora_mm(bf.ab, x), bf.ab_b);                                  // [2G, n]
+    ggml_tensor * g    = ggml_mul(ctx0, ggml_softplus(ctx0, ggml_add(ctx0,
+                             ggml_view_2d(ctx0, ab, G, n_tokens, ab->nb[1], 0), bf.dt)), bf.a);            // [G, n]
+    ggml_tensor * beta = ggml_mul(ctx0, ggml_view_2d(ctx0, ggml_sigmoid(ctx0, ab), G, n_tokens, ab->nb[1], G * f4),
