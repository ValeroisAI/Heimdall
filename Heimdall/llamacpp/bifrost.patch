+// ---------------------------------------------------------------------------------------------------------------------
+// Bifrost (Valerois): a full-attention layer converted to
+//     o = o_win + gamma * (mem_scale * o_mem - o_win),   y = W_o (o * sigmoid(gate))
+//   o_win : softmax attention over the S sink tokens + the last W tokens (the teacher's own q/k/v, exact inside W)
+//   o_mem : gated delta rule; token j is written when it leaves the window (t = j + W); one state per query head
+//   gamma : sigmoid(W_mix x + mix_lse * (lse_win - log W)) for pos >= W, else 0
+// Per-sequence state (recurrent memory row "cache_bifrost_l"):
+//   region [S + W + 2 rows of C]: sinks | ring of W+1 slots (slot = S + pos mod (W+1)) | scratch;  delta [D, D, G]
+// The ring has one slot more than the window, so the row leaving the window (pos - W) and the row written by the
+// current token never share a slot. The delta state is kept per KV head: all query heads of a group share it.
+// Reference implementation and tests: Heimdall/heimdall/hibrit.py (HybridAttention._student).
+
+bool llm_graph_input_bifrost::can_inplace(const llama_memory_recurrent_context * mctx, int64_t n_seqs) {
+    if (mctx == nullptr || mctx->get_rs_z() >= 0 || (int64_t) mctx->get_n_rs() != n_seqs) {
+        return false;
+    }
+    for (int64_t i = 0; i < n_seqs; ++i) {
+        if (mctx->s_copy(i) != (int32_t) (mctx->get_head() + i)) {
+            return false;
+        }
+    }
+    return true;
+}
