+    const int64_t kv_head = mctx_cur->get_head();
+    ggml_tensor * b_all = mctx_cur->get_b_l(il);
+    const int64_t Nb = hparams.bifrost_state();
+    const size_t  row = b_all->nb[1];
+    const size_t  off_delta = LR * C * f4;
+
+    // in place: the ubatch's states are read straight from the cache (no per-token copy of the whole state)
+    ggml_tensor * st     = bi->inplace ? ggml_view_2d(ctx0, b_all, Nb, B, row, kv_head * row) : build_rs(inp, b_all, Nb, B);
+    ggml_tensor * reg_st = ggml_view_3d(ctx0, st, C, LR, B, C * f4, st->nb[1], 0);
+    ggml_tensor * reg    = ggml_view_3d(ctx0, b_all, C, LR, B, C * f4, row, kv_head * row);              // destination
+    ggml_tensor * s_old  = ggml_view_4d(ctx0, st, D, D, G, B, D * f4, D * D * f4, st->nb[1], off_delta);
+    if (B > 1) {
+        s_old = ggml_cont(ctx0, s_old);
+    }
+    ggml_tensor * s_dst  = ggml_view_4d(ctx0, b_all, D, D, G, B, D * f4, D * D * f4, row, kv_head * row + off_delta);
+
+    const float kq_scale = hparams.f_attention_scale == 0.0f ? 1.0f / sqrtf(float(D)) : hparams.f_attention_scale;
+    ggml_tensor * keys;   // [2GD, Lk, B]: k_rope | v per key
+    ggml_tensor * wrow;   // [C, T, B]: write rows for this ubatch (positions p - W)
+
+    if (dec) {
+        // decode: read the row leaving the window, write this token's row into another slot (no ordering needed)
+        wrow = ggml_get_rows(ctx0, reg_st, bi->idx_ring);                                               // [C, 1, B]
+        ggml_tensor * r1 = ggml_set_rows(ctx0, reg, F3, bi->idx_sink1);                                 // sink slot (or scratch)
+        ggml_tensor * r2 = ggml_set_rows(ctx0, r1, F3, bi->idx_wb);                                     // ring slot
+        keys = ggml_view_3d(ctx0, r2, 2 * GD, LR, B, r2->nb[1], r2->nb[2], 0);
+    } else {
+        // prefill: ring in time order, then the new tokens; write back the last min(T, W) rows and the sinks
+        auto after = [&](ggml_tensor * z, ggml_tensor * dep) {   // orders a state write after a read it does not use
+            return ggml_add(ctx0, z, ggml_scale(ctx0, ggml_view_1d(ctx0, dep, 1, 0), 0.0f));
+        };
+        ggml_tensor * ring_time = ggml_get_rows(ctx0, reg_st, bi->idx_ring);                            // [C, W, B]
+        ggml_tensor * sink_old  = ggml_cont(ctx0, ggml_view_3d(ctx0, reg_st, 2 * GD, S, B, C * f4, st->nb[1], 0));
+        ggml_tensor * ext = ggml_concat(ctx0, ring_time, F3, 1);                                        // [C, W+T, B]
+        const int64_t n = std::min(T, W);
+        ggml_tensor * last = ggml_view_3d(ctx0, ext, C, n, B, ext->nb[1], ext->nb[2], (W + T - n) * ext->nb[1]);
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, reg, after(ggml_cont(ctx0, last), sink_old), bi->idx_wb));
+
+        ggml_tensor * cand = ggml_get_rows(ctx0, ggml_cont(ctx0, ggml_view_2d(ctx0, F, 2 * GD, n_tokens, F->nb[1], 0)), bi->sink_idx);
+        cand = ggml_reshape_3d(ctx0, cand, 2 * GD, S, B);
+        ggml_tensor * sink_new = ggml_add(ctx0, sink_old, ggml_mul(ctx0, ggml_sub(ctx0, cand, sink_old), bi->sink_sel));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, sink_new,
+            ggml_view_3d(ctx0, b_all, 2 * GD, S, B, C * f4, row, kv_head * row)));
+
+        ggml_tensor * ext_kv = ggml_cont(ctx0, ggml_view_3d(ctx0, ext, 2 * GD, W + T, B, ext->nb[1], ext->nb[2], 0));
+        keys = ggml_concat(ctx0, sink_new, ext_kv, 1);                                                   // [2GD, S+W+T, B]
+        wrow = ggml_view_3d(ctx0, ext, C, T, B, ext->nb[1], ext->nb[2], 0);
+    }
+
+    // ---- window + sink softmax attention
+    const int64_t Lk = keys->ne[1];
+    ggml_tensor * V4 = ggml_view_4d(ctx0, keys, D, G, Lk, B, D * f4, keys->nb[1], keys->nb[2], GD * f4);
+    ggml_tensor * Vt = ggml_cont(ctx0, ggml_permute(ctx0, V4, 1, 2, 0, 3));                              // [Lk, D, G, B]
+    ggml_tensor * kq;
+    if (dec) {
+        // the R query heads of a KV group are the R columns of one matmul: each key row is read once per group
+        ggml_tensor * Kg = ggml_view_4d(ctx0, keys, D, Lk, G, B, keys->nb[1], D * f4, keys->nb[2], 0);  // [D, Lk, G, B]
+        kq = ggml_mul_mat(ctx0, Kg, ggml_reshape_4d(ctx0, Qr, D, R, G, B));                              // [Lk, R, G, B]
+    } else {
+        ggml_tensor * K4 = ggml_view_4d(ctx0, keys, D, G, Lk, B, D * f4, keys->nb[1], keys->nb[2], 0);
+        ggml_tensor * Kt = ggml_cont(ctx0, ggml_permute(ctx0, K4, 0, 2, 1, 3));                          // [D, Lk, G, B]
+        ggml_tensor * Qt = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_4d(ctx0, Qr, D, H, T, B), 0, 2, 1, 3)); // [D, T, H, B]
+        kq = ggml_mul_mat(ctx0, Kt, Qt);                                                                 // [Lk, T, H, B]
+    }
+    ggml_prec_set_acc(kq, GGML_PREC_F32);
+    ggml_tensor * p  = ggml_soft_max_ext(ctx0, kq, bi->kq_mask, kq_scale, 0.0f);
+    // log-sum-exp of the window: lse = E_p[s] + H(p)   (masked entries have p = 0)
+    ggml_tensor * lse = ggml_sub(ctx0,
+        ggml_sum_rows(ctx0, ggml_mul(ctx0, p, ggml_scale(ctx0, kq, kq_scale))),
+        ggml_sum_rows(ctx0, ggml_mul(ctx0, p, ggml_log(ctx0, ggml_clamp(ctx0, p, 1e-30f, 1.0f)))));
+    ggml_tensor * o_win = ggml_mul_mat(ctx0, Vt, p);
+    ggml_tensor * lse2;                                                                                  // [H, n]
+    if (dec) {                                                // [D, R, G, B] = [D, H, 1, B]: already in token order
+        lse2 = ggml_reshape_2d(ctx0, lse, H, n_tokens);
+    } else {                                                  // [D, T, H, B] -> [D, H, T, B]
+        o_win = ggml_cont(ctx0, ggml_permute(ctx0, o_win, 0, 2, 1, 3));
+        lse2  = ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, lse, T, H, B), 1, 0, 2, 3)), H, n_tokens);
+    }
+
+    // ---- memory: write rows (positions p0-W ..), one delta state per KV head
+    auto part = [&](int64_t d, size_t off) {                  // [d, G, T, B] view of the write rows
+        return ggml_view_4d(ctx0, wrow, d, G, T, B, d * f4, wrow->nb[1], wrow->nb[2], off);
+    };
+    ggml_tensor * o_mem;                                                                                 // [D, H, n]
+    ggml_tensor * s_new;
+    if (dec) {
+        // update the G states with the leaving rows, then read them with all R query heads of each group
+        ggml_tensor * wk = part(D, 2 * GD * f4);
+        ggml_tensor * wg = part(1, 3 * GD * f4);
+        ggml_tensor * wb = part(1, (3 * GD + G) * f4);
+        if (B > 1) {
+            wg = ggml_cont(ctx0, wg);
+            wb = ggml_cont(ctx0, wb);
+        }
+        auto res = build_delta_net(wk, wk, part(D, GD * f4), wg, wb, s_old, il);
+        s_new = res.second;                                                                              // [D, D, G, B]
+        o_mem = ggml_mul_mat(ctx0, s_new, ggml_reshape_4d(ctx0, qm, D, R, G, B));                        // [D, R, G, B]
+    } else {
+        // prefill needs every intermediate state: run the delta rule on H heads (states repeated per query head)
+        auto expand = [&](ggml_tensor * z) {                  // [d, G, T, B] -> [d, H, T, B], h = g*R + r
+            const int64_t d = z->ne[0];
+            z = ggml_reshape_4d(ctx0, ggml_cont(ctx0, z), d, 1, G, T * B);
+            return ggml_reshape_4d(ctx0, ggml_repeat_4d(ctx0, z, d, R, G, T * B), d, H, T, B);
+        };
+        ggml_tensor * s_rep = ggml_reshape_4d(ctx0,
+            ggml_repeat_4d(ctx0, ggml_reshape_4d(ctx0, s_old, D * D, 1, G, B), D * D, R, G, B), D, D, H, B);
+        auto res = build_delta_net(ggml_reshape_4d(ctx0, qm, D, H, T, B), expand(part(D, 2 * GD * f4)),
+                                   expand(part(D, GD * f4)), expand(part(1, 3 * GD * f4)),
+                                   expand(part(1, (3 * GD + G) * f4)), s_rep, il);
+        o_mem = res.first;                                                                               // [D, H, T, B]
+        s_new = ggml_view_4d(ctx0, res.second, D, D, G, B, res.second->nb[1], R * res.second->nb[2],
+                             res.second->nb[3], 0);                                                      // head r = 0 of each group
+    }
+    ggml_build_forward_expand(gf, ggml_cpy(ctx0, s_new, s_dst));
+
+    // ---- mix
+    ggml_tensor * mix = ggml_add(ctx0, build_lora_mm(bf.mix, x), bf.mix_b);                              // [H, n]
+    lse2 = ggml_scale_bias(ctx0, lse2, 1.0f, -logf((float) W));
+    ggml_tensor * gamma = ggml_sigmoid(ctx0, ggml_add(ctx0, mix, ggml_mul(ctx0, lse2, bf.mix_lse)));
+    gamma = ggml_mul(ctx0, gamma, bi->m_win);                                                           // [H, n]
+
+    ggml_tensor * ow = ggml_reshape_3d(ctx0, o_win, D, H, n_tokens);
+    ggml_tensor * om = ggml_reshape_3d(ctx0, o_mem, D, H, n_tokens);
+    om = ggml_mul(ctx0, om, ggml_reshape_2d(ctx0, bf.mem_scale, 1, H));
+    ggml_tensor * o = ggml_add(ctx0, ow, ggml_mul(ctx0, ggml_sub(ctx0, om, ow), ggml_reshape_3d(ctx0, gamma, 1, H, n_tokens)));
+    cb(o, "bifrost_o", il);
+
+    o = ggml_mul(ctx0, ggml_reshape_2d(ctx0, o, D * H, n_tokens), ggml_sigmoid(ctx0, gate));
+    return build_lora_mm(layer.wo, o, layer.wo_s);
+}
