+void llm_graph_input_bifrost::set_input(const llama_ubatch * ubatch) {
+    const int64_t T = ubatch->n_seq_tokens, B = ubatch->n_seqs, W = window, S = sinks, WR = W + 1;
+    GGML_ASSERT(ubatch->n_tokens == T * B);
+    const bool    dec  = T == 1;
+    const int64_t L    = dec ? S + WR + 1 : S + W + T;    // decode: region slots | prefill: sinks + time-ordered ring + new
+    const int64_t rows = dec ? n_rep : T;                 // decode: one (identical) row per query head of a group
+    const int64_t scratch = S + WR;                        // region slot that is never attended
+    auto slot = [&](int64_t pos) { return (int32_t) (S + ((pos % WR) + WR) % WR); };
+
+    std::vector<float>   mask(L * rows * B), ms(T * B), mw(T * B), sel(S * B, 0.0f);
+    std::vector<int32_t> sidx(S * B, 0), ring((dec ? 1 : W) * B), wb(std::min(T, W) * B), s1(B);
+
+    for (int64_t s = 0; s < B; ++s) {
+        const int64_t p0 = ubatch->pos[s * T];
+        for (int64_t t = 0; t < T; ++t) {
+            GGML_ASSERT(ubatch->pos[s * T + t] == p0 + t && "bifrost: positions must be consecutive within a sequence");
+            const int64_t q = p0 + t;
+            float * row = mask.data() + (s * rows + (dec ? 0 : t)) * L;
+            for (int64_t l = 0; l < L; ++l) {
+                bool ok;
+                if (l < S) {
+                    ok = l <= q;                                       // sink slot l holds position l
+                } else if (dec) {
+                    if (l == scratch) {
+                        ok = false;
+                    } else {                                           // ring slot r holds the latest position = r (mod W+1)
+                        const int64_t r = l - S, kp = q - ((q - r) % WR + WR) % WR;
+                        ok = kp >= 0 && kp >= S && q - kp < W;
+                    }
+                } else {
+                    const int64_t kp = p0 - W + (l - S);               // time-ordered ring, then this ubatch's tokens
+                    ok = kp >= 0 && kp >= S && kp <= q && q - kp < W;
+                }
+                row[l] = ok ? 0.0f : -INFINITY;
+            }
+            ms[s * T + t] = q >= S ? 1.0f : 0.0f;
+            mw[s * T + t] = q >= W ? 1.0f : 0.0f;
+        }
+        if (dec) {
+            for (int64_t r = 1; r < rows; ++r) {
+                std::copy_n(mask.data() + s * rows * L, L, mask.data() + (s * rows + r) * L);
+            }
+            ring[s] = slot(p0 - W);                                    // row leaving the window (read)
+            wb[s]   = slot(p0);                                        // this token's row (write)
+            s1[s]   = (int32_t) (p0 < S ? p0 : scratch);
+        } else {
+            for (int64_t m = 0; m < W; ++m) {
+                ring[s * W + m] = slot(p0 - W + m);
+            }
+            const int64_t n = std::min(T, W);
+            for (int64_t m = 0; m < n; ++m) {
+                wb[s * n + m] = slot(p0 + T - n + m);
+            }
+        }
+        for (int64_t j = 0; j < S; ++j) {
+            if (j >= p0 && j < p0 + T) {
+                sidx[s * S + j] = (int32_t) (s * T + (j - p0));
+                sel[s * S + j]  = 1.0f;
+            }
+        }
+    }
+    ggml_backend_tensor_set(kq_mask,  mask.data(), 0, ggml_nbytes(kq_mask));
+    ggml_backend_tensor_set(m_sink,   ms.data(),   0, ggml_nbytes(m_sink));
+    ggml_backend_tensor_set(m_win,    mw.data(),   0, ggml_nbytes(m_win));
+    ggml_backend_tensor_set(idx_ring, ring.data(), 0, ggml_nbytes(idx_ring));
+    ggml_backend_tensor_set(idx_wb,   wb.data(),   0, ggml_nbytes(idx_wb));
+    if (dec) {
+        ggml_backend_tensor_set(idx_sink1, s1.data(), 0, ggml_nbytes(idx_sink1));
+    } else {
+        ggml_backend_tensor_set(sink_idx, sidx.data(), 0, ggml_nbytes(sink_idx));
+        ggml_backend_tensor_set(sink_sel, sel.data(),  0, ggml_nbytes(sink_sel));
+    }
+}
