+    ggml_tensor * wv = expand(part(GD, GD * f4), D);
+    ggml_tensor * wg = expand(part(G, 3 * GD * f4), 1);
+    ggml_tensor * wb = expand(part(G, (3 * GD + G) * f4), 1);
